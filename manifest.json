<!-- マスター・マニフェストの読み込み -->
<link rel="manifest" href="manifest.json">

<!-- マスター・サービスワーカーの登録 -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./sw.js')
        .then(reg => console.log('[System] Service Worker 登録完了', reg.scope))
        .catch(err => console.warn('[System] Service Worker 登録失敗', err));
    });
  }
</script>
